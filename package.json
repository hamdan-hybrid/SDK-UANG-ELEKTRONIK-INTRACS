{
  "name": "hybrid-passti",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js web bridge for the PASSTI reader",
  "main": "server.js",
  "scripts": {
    "start": "node start.js",
    "dev": "node --env-file=.env --watch server.js",
    "build": "node build.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart hybrid-passti",
    "pm2:stop": "pm2 stop hybrid-passti",
    "pm2:logs": "pm2 logs hybrid-passti"
  },
  "engines": {
    "node": "^22.0.0"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "express": "^4.21.2",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.8.0"
  }
}
